// QWASH veritabani semasi — Faz 2: kullanici, cuzdan, ledger, program/tarife.
// Tasarim: docs/DATABASE.md, ADR-0004 (kurus + ledger).
// Seans, cihaz ve kimlik yontemleri tablolari sonraki fazlarda eklenecek.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum LedgerType {
  CREDIT // Bakiyeye para girisi
  DEBIT // Bakiyeden dogrudan cikis (duzeltme/iade)
  HOLD // Kullanilabilir bakiyenin bloke edilmesi
  CAPTURE // Bloke edilen tutarin kalici tahsili
  RELEASE // Bloke edilen tutarin serbest birakilmasi
}

enum LedgerSource {
  CARD_TOPUP
  CASH_TOPUP
  SESSION
  ADJUSTMENT
  REFUND // Iade talebi blokesi ve iade cikisi
  FORFEIT // Hesap silmede musterinin feragat ettigi bakiye
  CASH_REFUND // Istasyonda kasadan nakit iade (Faz 6)
  SERVICE_REFUND // Teknik hata iadesi: seans ucreti bakiyeye geri (seans basina bir kez)
}

enum HoldStatus {
  ACTIVE // Bloke devam ediyor
  CAPTURED // Tahsil edildi (kalan kismi serbest birakildi)
  RELEASED // Tamamen serbest birakildi
}

enum BayStatus {
  IDLE
  WAITING
  RUNNING
  OFFLINE
  MAINTENANCE
  ERROR
}

model User {
  id              String          @id @default(uuid())
  email           String          @unique
  passwordHash    String? // Yalnizca Google ile acilan hesapta null (ADR-0009)
  emailVerifiedAt DateTime?
  phoneNumber     String?         @unique
  role            UserRole        @default(USER)
  status          UserStatus      @default(ACTIVE)
  fullName        String? // Odeme saglayicisi alici adi ister (Iyzico); Google'dan gelir
  // Ilk basarili kart yuklemesinde muhurlenir; sonra ad yalniz destekle degisir.
  // IBAN iadesinde alici adi bununla karsilastirilir (ROADMAP acik soru 4).
  nameLockedAt    DateTime?
  deletedAt       DateTime?
  refundRequests  RefundRequest[]
  wallet          Wallet?
  sessions        WashSession[]
  identities      AuthIdentity[]
  refreshTokens   RefreshToken[]
  authTokens      AuthToken[]
  cardTopUps      CardTopUp[]
  cashTopUps      CashTopUp[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

enum AuthProvider {
  GOOGLE
}

// Harici kimlik yontemleri (ADR-0009). E-posta/sifre User.passwordHash'te durur.
model AuthIdentity {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       AuthProvider
  providerUserId String // Google "sub"
  createdAt      DateTime     @default(now())

  @@unique([provider, providerUserId])
  @@index([userId])
}

// Opak refresh token; yalniz SHA-256 ozeti saklanir (SECURITY.md 1.2).
// Donusumde eski kayit revokedAt alir; iptal edilmis token tekrar gelirse
// kullanicinin tum oturumlari kapatilir (token reuse).
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

// Tek kullanimlik e-posta dogrulama / sifre sifirlama token'lari; yalniz ozet saklanir.
model AuthToken {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, type])
}

// balanceKurus: cuzdandaki toplam para (bloke dahil).
// holdKurus:    bunun bloke edilen kismi. Kullanilabilir = balance - hold.
// Kurallar veritabaninda CHECK constraint ile de zorlanir (migration SQL).
model Wallet {
  id            String        @id @default(uuid())
  userId        String        @unique
  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  balanceKurus  BigInt        @default(0)
  holdKurus     BigInt        @default(0)
  currency      String        @default("TRY")
  ledgerEntries LedgerEntry[]
  holds         WalletHold[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

enum CardTopUpStatus {
  PENDING // Odeme formu acildi, sonuc bekleniyor
  SUCCEEDED // Iyzico odemeyi onayladi, bakiye yuklendi
  FAILED // Iyzico reddetti / musteri vazgecti
  EXPIRED // Form suresi doldu, sonuc gelmedi (mutabakat isaretler)
  REVERSAL_PENDING // Odeme alindi ama hesap aktif degil; bakiye yazilmadi, Iyzico iptal/iade bekleniyor
  REVERSED // Hesap kapali oldugu icin odeme Iyzico'da iptal/iade edildi
}

// Iyzico Checkout Form ile kart yuklemesi (ADR-0003, Faz 5b).
// Bakiye yalniz SUCCEEDED gecisiyle ayni transaction'da, `card-topup:<id>` anahtariyla
// yuklenir; callback, webhook ve mutabakat ayni gecisi yarissa bile tek CREDIT olusur.
// Iade (yalniz orijinal karta, admin onayiyla, Faz 6) icin Iyzico kimlikleri saklanir.
model CardTopUp {
  id                   String          @id @default(uuid())
  userId               String
  user                 User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  walletId             String
  amountKurus          Int
  status               CardTopUpStatus @default(PENDING)
  idempotencyKey       String // Istemcinin Idempotency-Key basligi
  iyzicoToken          String?         @unique
  paymentPageUrl       String? // Ayni Idempotency-Key tekrarinda ayni sayfa doner
  iyzicoPaymentId      String?
  paymentTransactionId String? // Iade (/payment/refund) icin gerekli
  refundedKurus        Int             @default(0)
  failureReason        String?
  createdAt            DateTime        @default(now())
  completedAt          DateTime?

  @@unique([userId, idempotencyKey])
  @@index([status, createdAt])
}

enum RefundReason {
  ACCOUNT_DELETION
  SERVICE_FAILURE
}

enum RefundRequestStatus {
  REQUESTED // Tutar blokede, admin islemi bekleniyor (Faz 6)
  COMPLETED
  REJECTED
}

// Musterinin iade talebi. Tutar talep aninda WalletHold ile ayrilir, harcanamaz.
// Kullanici anonimlestirilse bile admin EFT'de karsilastirabilsin diye muhurlu ad,
// iletisim e-postasi, IBAN ve FIFO dagilimi talep aninda buraya kopyalanir.
// `allocation`: [{ method: CARD|IBAN|CASH_AT_STATION, source, amountKurus,
//                 cardTopUpId?, paymentTransactionId?, creditedAt }]
model RefundRequest {
  id           String              @id @default(uuid())
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  walletId     String
  holdId       String              @unique
  reason       RefundReason
  status       RefundRequestStatus @default(REQUESTED)
  amountKurus  Int
  holderName   String
  contactEmail String? // Iade sonucunu bildirmek icin; talep kapaninca temizlenir (Faz 6)
  iban         String?
  allocation   Json
  createdAt    DateTime            @default(now())
  resolvedAt   DateTime?
  resolvedBy   String? // Admin kullanici id
  rejectReason String?
  payouts      RefundPayout[]

  @@index([status, createdAt])
}

// Yukleme ayarlari; tek satir (id = 1). Admin paneli (Faz 6) degistirir.
// Hazir tutarlar minimumun katlaridir: min, 2*min, 4*min (Burak, 2026-09-26).
model TopUpSettings {
  id            Int      @id @default(1)
  minTopUpKurus Int      @default(5000)
  maxTopUpKurus Int      @default(500000)
  updatedAt     DateTime @updatedAt
}

// Degistirilemez muhasebe kaydi. UPDATE/DELETE veritabani trigger'i ile engellenir.
model LedgerEntry {
  id                String       @id @default(uuid())
  walletId          String
  wallet            Wallet       @relation(fields: [walletId], references: [id], onDelete: Restrict)
  type              LedgerType
  source            LedgerSource
  amountKurus       BigInt // Her zaman > 0; yon `type` ile belirlenir
  balanceAfterKurus BigInt
  holdAfterKurus    BigInt
  holdId            String?
  hold              WalletHold?  @relation(fields: [holdId], references: [id], onDelete: Restrict)
  referenceId       String? // SessionId, PaymentId, CashTopUpId...
  idempotencyKey    String?      @unique
  note              String?
  createdAt         DateTime     @default(now())

  @@index([walletId, createdAt])
}

// Her bloke ayri izlenir: bir bloke yalnizca bir kez tahsil/serbest birakilabilir
// ve bloke edilenden fazla tahsil edilemez.
model WalletHold {
  id             String        @id @default(uuid())
  walletId       String
  wallet         Wallet        @relation(fields: [walletId], references: [id], onDelete: Restrict)
  amountKurus    BigInt // Bloke edilen tutar (> 0)
  capturedKurus  BigInt        @default(0)
  status         HoldStatus    @default(ACTIVE)
  source         LedgerSource
  referenceId    String?
  idempotencyKey String        @unique
  ledgerEntries  LedgerEntry[]
  session        WashSession?
  createdAt      DateTime      @default(now())
  settledAt      DateTime?

  @@index([walletId, status])
}

model Station {
  id         String        @id @default(uuid())
  code       String        @unique // Orn: "STATION-01"
  name       String
  bays       Bay[]
  programs   WashProgram[]
  cashTopUps CashTopUp[]
  createdAt  DateTime      @default(now())
}

model Bay {
  id                String        @id @default(uuid())
  bayCode           String        @unique // QR icerigi (Orn: "BAY-001")
  name              String
  status            BayStatus     @default(IDLE)
  // Bakim modu (ADR-0011 #6): calisma durumundan ayri tutulur; seans bitince status IDLE
  // olsa da peron bakimda kalir. Doluysa yeni seans baslatilamaz.
  maintenanceAt     DateTime?
  maintenanceReason String?
  maintenanceBy     String?
  stationId         String
  station           Station       @relation(fields: [stationId], references: [id], onDelete: Restrict)
  programs          BayProgram[]
  sessions          WashSession[]
  device            Device?
  createdAt         DateTime      @default(now())
}

// ---------------------------------------------------------------------------
// Faz 4: seans, cihaz, outbox/inbox (ADR-0005, ADR-0007, ADR-0010)
// ---------------------------------------------------------------------------

enum SessionStatus {
  STARTING // Bloke alindi, START outbox'ta; cihaz ACK'i bekleniyor
  RUNNING // Cihaz STARTED_ACK verdi, role acik
  COMPLETED // Cihaz bitisi bildirdi, kullanilan sure tahsil edildi
  FAILED // ACK gelmedi veya cihaz reddetti; bloke tamamen iade edildi
  RECONCILING // Planlanan sure + tolerans gecti, cihazdan bitis gelmedi; bloke duruyor
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  EXPIRED // Yayinlanamadan gecerlilik suresi doldu (START icin anlamsizlasti)
}

model WashSession {
  id                  String              @id @default(uuid())
  userId              String
  user                User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  walletId            String
  bayId               String
  bay                 Bay                 @relation(fields: [bayId], references: [id], onDelete: Restrict)
  programId           String
  program             WashProgram         @relation(fields: [programId], references: [id], onDelete: Restrict)
  relayIndex          Int
  pricePerSecondKurus Int // Baslangictaki fiyatin kopyasi (sonradan fiyat degisse de seans etkilenmez)
  plannedDurationSec  Int
  holdId              String              @unique
  hold                WalletHold          @relation(fields: [holdId], references: [id], onDelete: Restrict)
  status              SessionStatus       @default(STARTING)
  idempotencyKey      String              @unique // Istemcinin "baslat" istegi anahtari
  startCommandId      String              @unique
  ackDeadlineAt       DateTime
  startedAt           DateTime?
  endedAt             DateTime?
  usedSeconds         Int?
  // Cihazin seans sirasinda bildirdigi kalan sureden hesaplanan, kesin calisilmis sure.
  // Yalnizca artar. Cihaz kaybolursa tahsilat buna gore yapilir (ADR-0010 #8).
  provenUsedSec       Int                 @default(0)
  reconcilingAt       DateTime?
  needsReview         Boolean             @default(false) // Admin incelemesi (Faz 6)
  reviewedAt          DateTime? // Admin inceledi (needsReview kalir, gecmis icin)
  reviewedBy          String?
  reviewNote          String?
  // STOP takibi: musteri durdurma ani (tahsilat tavani) ve STOP'un cihaza ulastigi an.
  // Onay gelene kadar STOP yeniden gonderilir (ADR-0010 #9).
  stopRequestedAt     DateTime?
  stopConfirmedAt     DateTime?
  lastStopSentAt      DateTime?
  stopAttempts        Int                 @default(0)
  stopReason          String?
  chargedKurus        BigInt?
  endReason           String?
  transitions         SessionTransition[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([status, ackDeadlineAt])
  @@index([userId, createdAt])
}

// Seansin her durum degisikligi: denetim izi.
model SessionTransition {
  id        String         @id @default(uuid())
  sessionId String
  session   WashSession    @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  fromState SessionStatus?
  toState   SessionStatus
  reason    String
  detail    Json?
  createdAt DateTime       @default(now())

  @@index([sessionId, createdAt])
}

// Cihazin bildirdigi son durum (device twin'in "reported" tarafi, ADR-0006).
model Device {
  deviceId         String    @id // MAC, ayiracsiz buyuk harf
  bayId            String?   @unique
  bay              Bay?      @relation(fields: [bayId], references: [id], onDelete: SetNull)
  reportedStatus   String // ONLINE, BUSY, OFFLINE, ERROR...
  firmwareVersion  String?
  resetReason      Int?
  lastSeenAt       DateTime
  // Device twin (ADR-0006): desired durum seans tablosundan turetilir; burada yalnizca
  // cihazin bildirdigiyle uyusmazlik tutulur. driftConfirmedAt tolerans asilinca dolar.
  driftKind        String?
  driftSessionId   String?
  driftSince       DateTime?
  driftConfirmedAt DateTime?
  lastDriftStopAt  DateTime?
  updatedAt        DateTime  @updatedAt
}

// MQTT'ye gidecek komutlar; is kaydiyla ayni transaction'da yazilir (ADR-0005).
model OutboxEvent {
  id          String       @id @default(uuid())
  topic       String
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  lastError   String?
  expiresAt   DateTime? // Bu andan sonra yayinlanmaz (START komutlari)
  sessionId   String?
  createdAt   DateTime     @default(now())
  publishedAt DateTime?

  @@index([status, createdAt])
}

// Cihazdan gelen mesajlarin tekrarini engeller (eventId ile).
model InboxMessage {
  messageId  String   @id
  topic      String
  receivedAt DateTime @default(now())
}

// Fiyatlari admin belirler; seed degerleri yalnizca ornektir.
model WashProgram {
  id                  String        @id @default(uuid())
  stationId           String
  station             Station       @relation(fields: [stationId], references: [id], onDelete: Restrict)
  code                String // "WATER", "FOAM", "WAX", "AIR" veya admin'in ekledigi kod
  name                String
  description         String?
  icon                String?
  pricePerSecondKurus Int // Orn: 50 = 0,50 TL/sn
  isActive            Boolean       @default(true)
  bayPrograms         BayProgram[]
  sessions            WashSession[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  deletedAt           DateTime? // Soft-delete: gecmis kayitlar korunur

  @@unique([stationId, code])
}

// Hangi peronda hangi program gecerli ve hangi role kanalina bagli.
model BayProgram {
  id         String      @id @default(uuid())
  bayId      String
  bay        Bay         @relation(fields: [bayId], references: [id], onDelete: Cascade)
  programId  String
  program    WashProgram @relation(fields: [programId], references: [id], onDelete: Restrict)
  relayIndex Int // Bu perondaki ESP32 role kanali (1..4)
  isEnabled  Boolean     @default(true)

  @@unique([bayId, programId])
  @@unique([bayId, relayIndex])
}

// ---------------------------------------------------------------------------
// Faz 6: admin operasyonlari (ADR-0011)
// ---------------------------------------------------------------------------

// Degistirilemez admin denetim kaydi. UPDATE/DELETE trigger ile reddedilir.
// Para hareket ettiren islemlerde ledger kaydiyla ayni transaction'da yazilir.
model AdminAuditLog {
  id         String   @id @default(uuid())
  actorId    String? // null: komut satiri betigi (admin:grant)
  action     String // CASH_TOPUP, BALANCE_ADJUSTMENT, REFUND_PAYOUT, ...
  targetType String // USER, REFUND_REQUEST, TOPUP_SETTINGS, ...
  targetId   String?
  reason     String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorId, createdAt])
}

// Kasada nakit yukleme. Bakiye `cash-topup:<idempotencyKey>` anahtarli CREDIT ile,
// bu kayit ve denetim kaydiyla ayni transaction'da yuklenir.
model CashTopUp {
  id             String   @id @default(uuid())
  receiptNo      Int      @unique @default(autoincrement()) // Makbuz numarasi; bosluk olabilir, tekrar olamaz
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  walletId       String
  stationId      String
  station        Station  @relation(fields: [stationId], references: [id], onDelete: Restrict)
  operatorId     String
  amountKurus    Int
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  @@index([stationId, createdAt])
}

enum RefundPayoutStatus {
  PENDING // Henuz odenmedi
  IN_FLIGHT // Iyzico'ya gonderildi, sonuc kaydedilmedi; otomatik yeniden denenmez
  DONE // Odendi
  FAILED // Iyzico reddetti; yeniden denenebilir
}

// Iade talebinin FIFO dagilimindaki her parca (ADR-0011 madde 5).
model RefundPayout {
  id              String             @id @default(uuid())
  refundRequestId String
  refundRequest   RefundRequest      @relation(fields: [refundRequestId], references: [id], onDelete: Restrict)
  partIndex       Int
  method          String // CARD | IBAN | CASH_AT_STATION
  amountKurus     Int
  cardTopUpId     String?
  status          RefundPayoutStatus @default(PENDING)
  reference       String? // Iyzico iade kimligi, EFT dekont no veya kasa notu
  failureReason   String?
  operatorId      String?
  stationId       String? // Kasadan odemede kasa raporu icin
  updatedAt       DateTime           @updatedAt
  completedAt     DateTime?

  @@unique([refundRequestId, partIndex])
  @@index([method, status, completedAt])
}
