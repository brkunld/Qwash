{
  "name": "qwash",
  "private": true,
  "description": "QWASH self-servis oto yikama platformu (monorepo)",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "ci:local": "node scripts/ci-local.mjs",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "db:generate": "pnpm --filter @qwash/backend db:generate",
    "db:migrate:dev": "pnpm --filter @qwash/backend db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @qwash/backend db:migrate:deploy",
    "db:seed": "pnpm --filter @qwash/backend db:seed",
    "db:studio": "pnpm --filter @qwash/backend db:studio",
    "admin:grant": "pnpm --filter @qwash/backend admin:grant",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "mqtt:credentials": "node scripts/mqtt-credentials.mjs",
    "mqtt:certs": "node scripts/mqtt-dev-certs.mjs",
    "infra:up": "docker compose --project-directory . -f docker/docker-compose.dev.yml up -d --wait",
    "infra:down": "docker compose --project-directory . -f docker/docker-compose.dev.yml down",
    "infra:check": "docker compose --project-directory . -f docker/docker-compose.dev.yml config --quiet"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "turbo": "^2.11.3",
    "typescript": "~6.0.3"
  }
}
