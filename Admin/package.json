{
  "name": "qwash-admin-desktop",
  "version": "1.0.0",
  "description": "QWASH Admin Desktop Panel",
  "main": "main.js",
  "author": "QWASH",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "electron-squirrel-startup": "^1.0.1"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.qwash.admin",
    "productName": "QWASH Admin",
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "test.html",
      "main.js",
      "preload.js",
      "firebase-config.js",
      "firebase-config-browser.js",
      "secrets.js",
      "images*",
      "build*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "QWASH Admin"
    }
  }
}
