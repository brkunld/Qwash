# QWASH production ortam degiskenleri. Sunucuda deploy/.env.production olarak kopyala (git disi).
# Rastgele deger: openssl rand -base64 48 | tr -d '/+=' | cut -c1-40
# Docker compose bu dosyayi hem degisken yerlestirme (--env-file) hem uygulama ortami (env_file) icin okur.

NODE_ENV=production
LOG_LEVEL=info
BACKEND_PORT=3001
TRUST_PROXY=1

# Adresler (DNS A kayitlari sunucu IP'sine)
CUSTOMER_HOST=qwash.example.com
ADMIN_HOST=admin.qwash.example.com
CUSTOMER_APP_URL=https://qwash.example.com
API_PUBLIC_URL=https://qwash.example.com
CORS_ORIGINS=https://qwash.example.com,https://admin.qwash.example.com
DEVICE_API_URL=https://qwash.example.com
DEVICE_QR_BASE=https://qwash.example.com/b/

# PostgreSQL (konteyner ic agi)
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://qwash:<POSTGRES_PASSWORD>@postgres:5432/qwash
DB_POOL_MAX=10

# MQTT (backend ic agdan duz baglanir; cihazlar 8883 TLS)
MQTT_URL=mqtt://qwash-backend:<sifre>@mosquitto:1883
MQTT_HEALTH_PASSWORD=

# Kimlik
JWT_ACCESS_SECRET=
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Iyzico (sandbox ile basla; canli: https://api.iyzipay.com)
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# E-posta (production'da zorunlu)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
ALERT_EMAIL=
