# QWASH gelistirme ortami ornek degiskenleri.
# Kopyala: cp .env.example .env  — .env asla commit edilmez.
# Buradaki degerler YALNIZCA yerel gelistirme icindir; gercek secret yazma.

NODE_ENV=development

# Backend
BACKEND_PORT=3001
LOG_LEVEL=debug

# Docker host portlari (docker/docker-compose.dev.yml). Cakisma olursa degistir.
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379
MQTT_HOST_PORT=11883
MQTT_WS_HOST_PORT=19001
MQTT_TLS_HOST_PORT=18883
# Cihazin baglandigi broker adresleri (sertifika SAN'i); degisince: pnpm mqtt:certs
MQTT_TLS_SANS=192.168.1.100

# PostgreSQL
POSTGRES_USER=qwash
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=qwash_dev
DATABASE_URL=postgresql://qwash:change-me-local-only@localhost:15432/qwash_dev

# Redis
REDIS_URL=redis://localhost:16379

# MQTT (gelistirme: kullanici/sifre + cihaz basina ACL, docker/mosquitto/acl; TLS sonraki adim)
# Degistirince: pnpm mqtt:credentials && docker compose ... restart mosquitto
MQTT_URL=mqtt://qwash-backend:change-me-local-only@localhost:11883
MQTT_HEALTH_PASSWORD=change-me-local-only
# deviceId:sifre (virgulle ayrilir); sifre cihazin kurulum portalina girilir
MQTT_DEVICE_CREDENTIALS=4CC382C3CC1C:change-me-local-only

# Kimlik dogrulama (Faz 5, SECURITY.md). Uretmek icin:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-local-only-at-least-32-characters
# Google girisi: Google Cloud Console > OAuth client (Web). Bos birakilirsa Google girisi kapali.
GOOGLE_CLIENT_ID=
# PWA (Google ile giris dugmesi): yukaridaki ile ayni deger. Gizli degildir.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# E-postadaki dogrulama/sifirlama baglantilari icin musteri PWA adresi; CORS: PWA (3000) + admin paneli (3002)
CUSTOMER_APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3002
# Veritabani baglanti havuzu (varsayilan 10). PostgreSQL max_connections'i asmamali (docs/LOAD-TEST.md).
DB_POOL_MAX=10
# Ters vekil (Nginx) sayisi; canlida Nginx arkasinda 1. Yanlis deger IP basina hiz sinirini bozar.
TRUST_PROXY=0

# Iyzico (Faz 5b, ADR-0003). Sandbox anahtarlari: https://sandbox-merchant.iyzipay.com
# > Ayarlar > Firma Ayarlari. Bos birakilirsa kartla yukleme kapali.
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# Iyzico odeme sayfasi musterinin tarayicisini buraya geri yollar (/api/v1/payments/iyzico/callback)
API_PUBLIC_URL=http://localhost:3001

# Web uygulamalari
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# E-posta (SMTP). Bos birakilirsa gelistirmede dogrulama/sifirlama baglantilari backend loguna yazilir;
# production'da SMTP_HOST ve MAIL_FROM zorunludur. Ayrinti: docs/DEVELOPMENT.md "E-posta (SMTP)".
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false, SMTP_USER=<gmail adresin>,
#        SMTP_PASSWORD=<16 haneli UYGULAMA SIFRESI, hesap sifren degil>, MAIL_FROM=QWash <gmail adresin>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
