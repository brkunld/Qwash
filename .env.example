# QWASH gelistirme ortami ornek degiskenleri.
# Kopyala: cp .env.example .env  — .env asla commit edilmez.
# Buradaki degerler YALNIZCA yerel gelistirme icindir; gercek secret yazma.

NODE_ENV=development

# Backend
BACKEND_PORT=3001
LOG_LEVEL=debug

# PostgreSQL (docker/docker-compose.dev.yml ile uyumlu)
POSTGRES_USER=qwash
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=qwash_dev
DATABASE_URL=postgresql://qwash:change-me-local-only@localhost:5432/qwash_dev

# Redis
REDIS_URL=redis://localhost:6379

# MQTT (gelistirme: sifresiz, yalniz localhost; Faz 4'te ACL + TLS)
MQTT_URL=mqtt://localhost:1883

# Web uygulamalari
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
